# Copy to .env.local for an intentional LOCAL test; never commit real values.
GYMBRO_PROBE_LOCAL=true
GYMBRO_SUPABASE_PROBE=true
GYMBRO_ACCOUNT_ACCESS=true
GYMBRO_CLOUD_ENV=preview
SUPABASE_PROJECT_REF=obebuvpsqapgevwivwho
SUPABASE_URL=https://obebuvpsqapgevwivwho.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# #28 synthetic Preview workouts only; never Production or personal data.
GYMBRO_PREVIEW_WORKOUTS=false
GYMBRO_PREVIEW_WORKOUT_OWNERS=
GYMBRO_PREVIEW_WORKOUT_FIXTURE_TAG=

# #84 Production rehearsal is a separate, default-off capability. Do not activate
# from this example. Exact deployment/SHA/build/operation approval is required.
GYMBRO_CUTOVER_REHEARSAL=false
# Operator read-only Production inspection is separately authorized per revision.
GYMBRO_CUTOVER_PRODUCTION_READ_APPROVED=false
GYMBRO_CUTOVER_READINESS_REVISION=
