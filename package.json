{
  "name": "gymbro",
  "private": true,
  "scripts": {
    "start": "python3 -m http.server 8000 --bind 127.0.0.1",
    "dev:probe": "node --env-file-if-exists=.env.local scripts/serve-probe.cjs",
    "db:preview": "node --env-file-if-exists=.env.local scripts/preview-db.cjs",
    "db:local:start": "supabase db start",
    "db:local:apply": "supabase migration up --local",
    "db:local:test": "supabase test db --local",
    "test": "node --test tests/*.test.cjs",
    "check:syntax": "node scripts/check-syntax.cjs",
    "check:release": "node scripts/check-release.cjs",
    "check:diff": "node scripts/check-diff.cjs"
  },
  "devDependencies": {
    "playwright-core": "1.58.2",
    "supabase": "2.122.0"
  }
}
